{
  "name": "pi-pitaj",
  "version": "0.3.1",
  "private": true,
  "description": "Ultra-fast in-process model consult extension for Pi",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test '*.test.ts'",
    "typecheck": "tsc --project tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "index.ts",
    "helpers.ts",
    "oracle.ts",
    "oracle-policy.ts",
    "snapshot.ts",
    "snapshot-runtime.ts",
    "settings-persistence.ts",
    "usage.ts",
    "settings.json",
    "README.md",
    "AGENTS.md",
    "DECISIONS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.13.3",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
